# Use local Node + PostgreSQL API (recommended for local dev)
# Set to true to use the api-server (Express + pg) for data and auth
VITE_USE_LOCAL_API=true

# Optional: backend URL when not using Vite proxy (e.g. production)
# VITE_API_URL=http://localhost:3001

# --- Tadabase (alternative to local API) ---
# VITE_TADABASE_API_URL=https://your-app.tadabase.io/api
# VITE_TADABASE_API_KEY=your_tadabase_api_key
# VITE_TADABASE_TABLE_HOTELS=table_xxx
# etc.

# Auth API URL for production (leave empty in dev; proxy used)
# VITE_AUTH_API_URL=
